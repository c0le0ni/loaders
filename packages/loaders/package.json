{
  "name": "@coleoni/loaders",
  "version": "1.0.0",
  "description": "27 loading indicators for React. Size, color, speed and pause on every one. Free, by Coleoni.",
  "license": "MIT",
  "author": "Coleoni (https://coleoni.com)",
  "homepage": "https://loaders.coleoni.com",
  "repository": {
    "type": "git",
