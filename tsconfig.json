{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@coleoni/loaders": ["./packages/loaders/src/index.ts"],
      "@coleoni/loaders/html": ["./packages/loaders/src/html.ts"]
    }
  },
  "include": ["src", "test", "packages/loaders/src"]
}
